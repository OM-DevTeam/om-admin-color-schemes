# src/*.css is tracked (see .gitignore), so GitHub's auto-generated tag/
# release source archive — and, via a plain Composer "vcs" repository, the
# archive Composer itself fetches for a given tag — is now a genuinely
# installable copy of this plugin, not just a source checkout. These
# export-ignore rules are what keep that archive down to just the files
# the plugin actually needs at runtime (see the release zip's own file
# list in dev/create-release-files.sh, which this mirrors) rather than
# also dragging in the SCSS source and every dev/build/lint tool.

/scss               export-ignore
/dev                export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/.stylelintrc.cjs   export-ignore
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/CLAUDE.md          export-ignore
